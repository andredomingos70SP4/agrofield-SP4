            saveData();
            document.getElementById('record-form').reset();
            document.getElementById('rec-date').value = getRelativeDate(0);
            clearLinkedScouting();
            selectOperationType('tratamento');
            refreshAllViews();
            switchView('history');
            showToast('Operação registada no caderno!');
        }

