            const parcelFilter = document.getElementById('filter-parcel')?.value || 'all';
            const typeFilter = document.getElementById('filter-type')?.value || 'all';

            let list = [...appData.records].sort((a, b) => new Date(b.date) - new Date(a.date));

            if (parcelFilter !== 'all') list = list.filter(r => r.parcelId === parcelFilter);
            if (typeFilter !== 'all') list = list.filter(r => r.type === typeFilter);
            if (search) {
                list = list.filter(r => {
                    const blob = [r.product, r.target, r.method, r.organism, r.qty, r.notes, r.operator].filter(Boolean).join(' ').toLowerCase();
                    return blob.includes(search);
                });
            }

            if (list.length === 0) {
                container.innerHTML = `<div class="bg-white rounded-2xl border border-slate-200 p-8 text-center text-sm text-slate-500">Sem registos no caderno para os filtros selecionados.</div>`;
